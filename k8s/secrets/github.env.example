# Only mounted into github-connector. Leave empty to run without a GitHub App (demo + public repos).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM content base64-encoded:  base64 -i app.private-key.pem | tr -d '\n'
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# optional read-only token for public repositories without the App (higher API rate limit)
GITHUB_TOKEN=
# optional: lets CI/scripts start scans via the API (header x-api-key)
SCAN_API_KEY=
